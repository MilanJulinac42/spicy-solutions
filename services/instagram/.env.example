# Kopiraj u .env i popuni. .env se NE commituje.

# --- Meta / Instagram ---
# Instagram → API setup with Instagram Login → App ID
IG_APP_ID=
# Settings → Basic → App Secret (posle reseta!)
# Potpisuje i webhook i `state` pri povezivanju klijenta.
IG_APP_SECRET=
# Biraš ga sam — bilo koji niz. Isti upisuješ u Meta webhook podešavanju.
IG_VERIFY_TOKEN=

# --- Povezivanje klijenata ---
# Javna adresa servisa, bez kose crte na kraju. Od nje se pravi redirect URI,
# koji mora isti da stoji i u Meta podešavanjima.
PUBLIC_URL=https://xxx.up.railway.app
# Biraš ga sam. Štiti /connect — bez njega bi svako ko pogodi adresu mogao da
# zakači svoj nalog i troši naš OpenAI budžet.
CONNECT_SECRET=

# Samo za prvi nalog. Servis ga pri prvom pokretanju prepiše u ig_accounts i
# posle toga ga ne koristi.
IG_ACCESS_TOKEN=

# --- Baza znanja (isti podaci kao sajt) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
